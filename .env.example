NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/hms_backend

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

TOKEN_BLACKLIST_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false

FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
ENABLE_HTTP_LOGS=true
ENABLE_FILE_LOGS=false
LOG_LEVEL=debug

BREVO_API_KEY=
SENDER_EMAIL=
ADMIN_EMAIL=

INDIA_LOCATION_SOURCE_URL=
INDIA_ADMIN_AREA_SOURCE_URL=
ALLOW_INSECURE_LOCATION_FETCH=false
ALLOW_INSECURE_EMAIL_TLS=false
